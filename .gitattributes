# .gitattributes — Git 改行コード・diff ドライバー設定
#
# end_of_line の統一方針:
#   - リポジトリ内はすべて LF で保存（eol=lf）
#   - Windows で checkout しても LF のまま（text=auto eol=lf）
#   - バイナリファイルは変換しない（binary）

# ============================================================
# デフォルト: テキストファイルは LF に正規化
# ============================================================
* text=auto eol=lf

# ============================================================
# Python
# ============================================================
*.py      text eol=lf
*.pyi     text eol=lf
*.pyw     text eol=lf

# ============================================================
# フロントエンド（TypeScript / JavaScript / JSON）
# ============================================================
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.json    text eol=lf
*.jsonc   text eol=lf
*.css     text eol=lf
*.html    text eol=lf

# ============================================================
# 設定ファイル類
# ============================================================
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.ini     text eol=lf
*.cfg     text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.sh      text eol=lf
Makefile  text eol=lf

# ============================================================
# Windows バッチ / PowerShell（CRLF が必要）
# ============================================================
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# ============================================================
# バイナリ（変換禁止）
# ============================================================
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.svg     binary
*.pdf     binary
*.docx    binary
*.xlsx    binary
*.zip     binary
*.tar.gz  binary
*.whl     binary
*.pyc     binary
