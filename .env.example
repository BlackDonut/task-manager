# =====================================================================
# .env.example - 環境変数テンプレート
# ---------------------------------------------------------------------
# 使い方:
#   1. このファイルを `.env` にコピー
#        (Windows) copy .env.example .env
#        (Unix)    cp .env.example .env
#   2. ローカル環境に合わせて値を書き換える
#   3. `.env` は絶対にコミットしない（.gitignore 済み）
#
# SSOT:
#   - app/core/config.py (Settings)
#   - docs/99_guides/environment-variables.md
# =====================================================================

# --- アプリケーション ---
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Redis（セッション） ---
REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=

# --- セッション ---
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=28800

# --- LDAP（ローカル開発では無効化） ---
LDAP_ENABLED=false
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_FILTER=(sAMAccountName={login_id})

# --- ファイルストレージ ---
# Windows 例: C:\\Users\\<user>\\task-manager-files
# Unix 例:    /srv/files
FILE_STORAGE_ROOT=./var/files

# --- SMTP（ローカル開発では無効化） ---
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
# SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@task-manager.example.com
SMTP_FROM_NAME=タスク管理システム
SMTP_RECIPIENT_DOMAIN=example.com
